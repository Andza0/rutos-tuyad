#!/bin/sh /etc/rc.common

START=95
STOP=95
USE_PROCD=1

start_service() {
        local enabled

        config_load 'tuyad'
        config_get enabled start_sct 'enable' '0'

        config_get productID start_sct 'productID'
        config_get deviceID start_sct 'deviceID'
        config_get device_secret start_sct 'device_secret'

	if [ "$enabled" -eq 1 ]; then
	        procd_open_instance
	        procd_set_param command /usr/bin/tuyad -p $productID -d $deviceID -s $device_secret
            procd_set_param stdout 1
            procd_set_param stderr 1
        	procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger "tuyad"
}

reload_service() {
	stop
	start
}
